        "fld_mvaefg6q_5trd9p8": "生信实验一：NCBI 浏览与序列文件解读",
        "fld_mvaefg6q_0pl2gpy": "opt_mvaefg6q_3vzi0ix",
        "fld_mvaefg6q_ht5erq8": true,
        "fld_date": "2026-10-18",
        "fld_note": "notes/生信实验/01/生物信息学实验报告_1_曹荣麟-2024014209_1.md",
        "fld_attachment": "notes/生信实验/01/生物信息学实验报告_1_曹荣麟-2024014209_1.md",
        "fld_number": 461,
        "fld_memo": "选定玉米 ZmFIE1（Gene ID 542075，RefSeq NM_001111711.1 / NP_001105181.1，461 aa）；纠正了原稿把 Zm00001eb318740 当成 FIE1 的错误。"
      },
      "notePath": "notes/生信实验/01/生物信息学实验报告_1_曹荣麟-2024014209_1.md",
