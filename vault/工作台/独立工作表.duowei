    {
      "id": "rec_cfb0417",
      "values": {
        "fld_mvaefg6q_5trd9p8": "生信实验二：Entrez 搜索 / EBI 浏览 / 双序列比对",
        "fld_mvaefg6q_0pl2gpy": "opt_mvaefg6q_3vzi0ix",
        "fld_mvaefg6q_ht5erq8": true,
        "fld_date": "2026-10-25",
        "fld_note": "vault/实验记录/2026-10-25-195500-生信实验二 Entrez搜索与双序列比对.md",
        "fld_attachment": "notes/生信实验/02/生物信息学实验报告_2_曹荣麟-2024014209.pdf",
        "fld_number": 70.1,
        "fld_memo": "人 EGF 家族：5 正（人/鼠/大鼠/犬/鸡）+ 5 旁（EGF/TGFA/AREG/EREG/HBEGF）。8 组 EMBOSS 比对；核酸局部一致性 70.1%，并系同源蛋白局部 33.3%。5 页 PDF + 7 张交互图。"
      },
      "notePath": "vault/实验记录/2026-10-25-195500-生信实验二 Entrez搜索与双序列比对.md",
