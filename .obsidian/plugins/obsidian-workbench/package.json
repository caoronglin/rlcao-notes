{
  "name": "obsidian-workbench",
  "version": "3.15.0",
  "description": "All-in-one Obsidian Workbench plugin: Git Panel, Dashboard, SM-2 Quiz, Pomodoro, Quick Capture, Daily Journal, Task Center, Projects, Privacy Zone, SiliconFlow RAG Search, Jev/Clef Decision & AI Assist with modular toggles",
  "main": "main.js",
  "scripts": {
    "build": "node scripts/esbuild.config.mjs",
    "test": "node scripts/esbuild.config.mjs && node --import ./tests/ts-loader.mjs --test tests/plugin.test.mjs",
    "build:check": "node scripts/esbuild.config.mjs --check"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "git",
    "workbench",
    "pomodoro",
    "spaced-repetition",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
